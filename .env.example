EHIS_ENV=local
EHIS_SERVICE_NAME=ehis-core
EHIS_DATABASE_URL=sqlite+aiosqlite:///./ehis.db
EHIS_ALLOWED_ORIGINS=http://localhost:5173
EHIS_LOG_LEVEL=INFO
EHIS_AUTH_ISSUER=https://identity.example.org
EHIS_AUTH_AUDIENCE=ehis-api
EHIS_STORAGE_PROVIDER=local
EHIS_STORAGE_LOCAL_PATH=./data/documents
EHIS_NOTIFICATION_OUTBOX_ENABLED=true
